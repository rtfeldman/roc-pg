+) error{OutOfMemory}!bool {
+    // TEMP-EXPERIMENT (ROC_EXP_EXH_MEMO): memoize per resolved var within the
+    // entry point; the walkers never unify, so the result only depends on the
+    // known-empty list, whose length is part of the hit condition.
+    if (tempExperimentEnabled("ROC_EXP_EXH_MEMO")) {
+        const memo_var = type_store.resolveVar(type_var).var_;
+        const memo = &builtin_idents.open_cache.inhabited_memo;
+        if (memo.get(memo_var)) |hit| {
+            if (hit.known_len == known_empty_vars.len) return hit.inhabited;
+        }
+        const result = try isTypeInhabitedWithKnownEmptyUncached(type_store, builtin_idents, type_var, known_empty_vars);
+        try memo.put(builtin_idents.open_cache.allocator, memo_var, .{ .known_len = @intCast(known_empty_vars.len), .inhabited = result });
+        return result;
+    }
+    return isTypeInhabitedWithKnownEmptyUncached(type_store, builtin_idents, type_var, known_empty_vars);
+}
