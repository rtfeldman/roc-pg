+        if (formal_resolved != .rigid) continue;
+        try self.rigid_var_substitutions.put(self.gpa, formal_resolved.rigid.name, arg_var);
+    }
+
+    // Copy only the projected tag's payload vars.
+    const projected_args_range = tags.items(.args)[found_idx];
+    const vars_top = self.scratch_vars.top();
+    defer self.scratch_vars.clearFrom(vars_top);
+    for (self.types.sliceVars(projected_args_range)) |arg_var| {
+        try self.scratch_vars.append(try self.instantiateVarWithSubs(arg_var, &self.rigid_var_substitutions, env, .{ .explicit = region }));
+    }
+    const new_args_range = try self.types.appendVars(self.scratch_vars.sliceFromStart(vars_top));
+
+    // Re-read the tags after appending (the store may have relocated).
+    const tags_after = self.types.getTagsSlice(template_union.tags);
+    const tags_top = self.scratch_tags.top();
+    defer self.scratch_tags.clearFrom(tags_top);
+    for (tags_after.items(.name), tags_after.items(.args), 0..) |name, tag_args, i| {
+        try self.scratch_tags.append(.{ .name = name, .args = if (i == found_idx) new_args_range else tag_args });
+    }
+    const new_ext = try self.freshFromContent(.{ .structure = .empty_tag_union }, env, region);
+    const union_content = try self.types.mkTagUnion(self.scratch_tags.sliceFromStart(tags_top), new_ext);
+    return try self.freshFromContent(union_content, env, region);
+}
