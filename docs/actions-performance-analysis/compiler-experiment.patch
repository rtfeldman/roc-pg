+/// TEMP-EXPERIMENT: env-var gated experiment toggles (analysis only).
+pub fn tempExperimentEnabled(comptime name: [:0]const u8) bool {
+    const Memo = struct {
+        var value: ?bool = null;
+    };
+    if (Memo.value) |value| return value;
+    const value = @import("builtin").link_libc and std.c.getenv(name) != null;
+    Memo.value = value;
+    return value;
+}
