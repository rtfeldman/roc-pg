+/// TEMP-EXPERIMENT (ROC_EXP_PROJECT_OPEN): open a closed-tag-union backing
+/// for ONE constructor: instantiate only that tag's payload (the part the
+/// constructor relation mutates) and share every other tag's template payload
+/// vars read-only in the result union. Returns null when the shape does not
+/// apply so the caller falls back to the full opening.
+fn openNominalBackingForAppProjected(
+    self: *Self,
+    nominal_type: types_mod.NominalType,
+    env: *Env,
+    region: Region,
+    tag_name: Ident.Idx,
+) std.mem.Allocator.Error!?Var {
+    const decl_idx = self.types.lookupNominalDecl(nominal_type) orelse return null;
+    const decl = self.types.getNominalDecl(decl_idx);
+    if (!decl.isValid()) return null;
+    const backing_resolved = self.types.resolveVar(decl.backing);
+    if (backing_resolved.desc.content != .structure or backing_resolved.desc.content.structure != .tag_union) return null;
+    const template_union = backing_resolved.desc.content.structure.tag_union;
+    const ext_content = self.types.resolveVar(template_union.ext).desc.content;
+    if (ext_content != .structure or ext_content.structure != .empty_tag_union) return null;
 
+    const tags = self.types.getTagsSlice(template_union.tags);
+    var found: ?usize = null;
+    for (tags.items(.name), 0..) |name, i| {
+        if (name.eql(tag_name)) {
+            found = i;
+            break;
+        }
+    }
+    const found_idx = found orelse return null;
+
+    const formals = self.types.sliceVars(decl.formals);
+    const args = self.types.sliceNominalArgs(nominal_type);
+    std.debug.assert(formals.len == args.len);
+    self.rigid_var_substitutions.clearRetainingCapacity();
+    for (formals, args) |formal_var, arg_var| {
